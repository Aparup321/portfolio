# Copy to .env for local dev. Never commit .env (see .gitignore).
# NOTE: This is a static frontend (no build step, no backend).
# Anything referenced in index.html / js/*.js ships to the browser
# and is PUBLIC via View Source — .env cannot hide frontend values.
# Use this only for local tooling / future backend (contact API, analytics).

# Public contact (already public in index.html, js/terminal.js — must stay public to work)
CONTACT_EMAIL=aparupsantra2004@gmail.com
SITE_URL=https://aparup.xyz

